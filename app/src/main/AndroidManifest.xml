<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Install App: Android's installer, which asks the person before each install. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Only for "Bluetooth discoverable", which asks Android to show its own dialog. -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <!-- Package visibility (QUERY_ALL_PACKAGES) comes from the platform module's manifest. -->
    <!-- Automations: "When the phone restarts", schedules on the minute (with Alarms & reminders
         allowed), and opening apps from the background (with Display over other apps allowed). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- The automation service, which runs only while an automation watches the phone. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:name=".DroidectiveApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Droidective">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The launcher starts this when a bar is added or reconfigured, so it's exported. -->
        <activity
            android:name=".widget.BarConfigureActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name=".widget.OpenActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <activity
            android:name=".automation.RunAutomationActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <activity
            android:name=".folder.FolderActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/Theme.Droidective.Panel" />

        <activity
            android:name=".screen.ToggleScreenActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/Theme.Droidective.Panel" />

        <receiver
            android:name=".widget.ToggleBarReceiver"
            android:exported="true"
            android:label="@string/widget_bar_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/toggle_bar_info" />
        </receiver>
        <receiver
            android:name=".widget.ButtonWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_button_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/button_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.ListWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_list_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/list_widget_info" />
        </receiver>

        <receiver
            android:name=".surface.NotificationTapReceiver"
            android:exported="false" />
        <receiver
            android:name=".monkey.MonkeyStopReceiver"
            android:exported="false" />

        <!-- Restarts, updates and clock changes. Protected broadcasts only the system can send. -->
        <receiver
            android:name=".automation.AutomationSystemReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
        <!-- Run from the Mac or adb. Only senders holding WRITE_SECURE_SETTINGS, and the receiver
             also checks the shell sent it. -->
        <receiver
            android:name=".RunAutomation"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS" />
        <receiver
            android:name=".automation.AutomationAlarmReceiver"
            android:exported="false" />
        <receiver
            android:name=".automation.StateSignalReceiver"
            android:exported="false" />
        <service
            android:name=".automation.AutomationService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs the automations the person set up: watches the triggers they chose (an app opening, charging, the screen, the battery, headphones, Wi-Fi, a setting changing) and acts when one fires; watches the apps they asked Crash Catcher to alert about; and, when they turn on Keep widgets live, keeps their home-screen widgets, tiles and notification bars answering taps at once and showing current states. Runs only while one of these is on." />
        </service>
        <service
            android:name=".performance.PerformanceOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Draws the Performance overlay the person turned on: a small window over other apps showing CPU load, the frames the app in front draws, memory and temperature, updated once a second while the screen is on. Runs only until they turn it off from the app or its notification." />
        </service>
        <service
            android:name=".screenrecord.ScreenRecordService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Records the screen while the person asked it to: runs Android's own screenrecord through the shell they set up, from Start until they press Stop or the time limit they chose, then saves the video to Movies. Runs only for that recording." />
        </service>
        <service
            android:name=".uiinspect.UiCaptureService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Captures the screen's view hierarchy when the person asks the UI Inspector to: counts down a few seconds so they can open the app to inspect, then runs uiautomator and takes a screenshot through the shell they set up. Runs only for those few seconds." />
        </service>
        <service
            android:name=".proxy.ProxyService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs the debugging proxy the person started in Network Traffic: listens on the phone's own loopback address, 127.0.0.1, so the person can see the HTTP and HTTPS requests their apps make and the answers that come back. Nothing off the device can reach it. Runs only until they press Stop in the app or its notification, and stopping puts the phone's proxy setting back the way it was." />
        </service>
        <!-- A Bluetooth device connecting or disconnecting. Protected broadcasts from the system;
             the receiver only re-reads which devices are connected. -->
        <receiver
            android:name=".automation.BluetoothSignalReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".automation.AutomationButtonReceiver"
            android:exported="false" />

