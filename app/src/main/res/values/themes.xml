<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; these only set the window before the first frame. -->
    <style name="Theme.Droidective" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Folders and the brightness slider: a panel over whatever was on screen. -->
    <style name="Theme.Droidective.Panel" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>
</resources>
