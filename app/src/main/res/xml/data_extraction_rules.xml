<?xml version="1.0" encoding="utf-8"?>
<!-- Widget layouts, folders, commands and automations back up and move to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="." />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
