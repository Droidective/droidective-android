<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.droidective.android"
    android:versionCode="22"
    android:versionName="0.20.0" >

    <uses-sdk
        android:minSdkVersion="30"
        android:targetSdkVersion="37" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Install App: Android's installer, which asks the person before each install. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Only for "Bluetooth discoverable", which asks Android to show its own dialog. -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <!-- Package visibility (QUERY_ALL_PACKAGES) comes from the platform module's manifest. -->
    <!--
         Automations: "When the phone restarts", schedules on the minute (with Alarms & reminders
         allowed), and opening apps from the background (with Display over other apps allowed).
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- The automation service, which runs only while an automation watches the phone. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!--
         Mock Location: asking for it is what lists Droidective in Developer options' "Select
         mock location app"; what it allows is decided there, not by this line.
    -->
    <uses-permission android:name="android.permission.ACCESS_MOCK_LOCATION" />
    <!-- Granted level: only `pm grant` from a shell can give these. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.DUMP" />
    <!--
         Crash Catcher reads crash reports from DropBox: Android 15 files them under
         READ_DROPBOX_DATA, earlier versions under READ_LOGS. Granted alongside the two above.
    -->
    <uses-permission android:name="android.permission.READ_DROPBOX_DATA" />
    <uses-permission
        android:name="android.permission.READ_LOGS"
        android:maxSdkVersion="34" /> <!-- App level: granted at install, or special access the user turns on in Settings. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SYNC_SETTINGS" />
    <!--
         AppCatalog lists every package, system ones included, and RootProbe and the Shizuku check
         look for apps by name. The build ships outside Play; a Play flavor drops this and goes
         back to <queries> (see CLAUDE.md).
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!--
         AdbPort browses mDNS for adbd. NsdManager won't start without INTERNET, and Android 17
         asks before an app browses the local network.
    -->
    <uses-permission android:name="android.permission.INTERNET" /> <!-- "An app is open" without Shell: usage access, which the person turns on in Settings. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <!--
         Automations' Bluetooth triggers ask the audio profiles who's connected. Nearby devices
         from Android 12; the plain Bluetooth permission before that.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <permission
        android:name="com.droidective.android.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.droidective.android.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <application
        android:name="com.droidective.android.DroidectiveApplication"
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:extractNativeLibs="false"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Droidective" >
        <activity
            android:name="com.droidective.android.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
                 An app package opened from Files, for Install App, which asks before installing.
                 Content URIs only: the code refuses file:// (Incoming).
            -->
            <intent-filter android:label="@string/open_install" >
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:scheme="content" />
                <data android:mimeType="application/vnd.android.package-archive" />
                <data android:mimeType="application/xapk-package-archive" />
                <data android:mimeType="application/vnd.apkm" />
            </intent-filter>
            <!-- Shared to Droidective: a package to install, or text with a link to try. -->
            <intent-filter android:label="@string/share_install" >
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="application/vnd.android.package-archive" />
                <data android:mimeType="application/xapk-package-archive" />
                <data android:mimeType="application/vnd.apkm" />
            </intent-filter>
            <intent-filter android:label="@string/share_link" >
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

